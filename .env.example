# === DATABASE ===
DATABASE_URL=postgresql://qeps_user:qeps_password@postgres:5432/qeps_db
POSTGRES_DB=qeps_db
POSTGRES_USER=qeps_user
POSTGRES_PASSWORD=qeps_password

# === SECURITY ===
JWT_SECRET=super_secret_jwt_key_change_in_production
REDIS_URL=redis://redis:6379/0

# === API KEYS ===
FMP_API_KEY=your_fmp_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# === DATA ===
DATA_LAKE_PATH=/app/data_lake
ENVIRONMENT=development

# === AUTH ===
AUTH_USER_1_EMAIL=admin1@example.com
AUTH_USER_1_PASSWORD=secure_password_1
AUTH_USER_2_EMAIL=admin2@example.com
AUTH_USER_2_PASSWORD=secure_password_2

# === DISCORD ALERTS ===
DISCORD_TRADING_WEBHOOK_URL=your_discord_trading_channel_webhook_url
DISCORD_ADMIN_WEBHOOK_URL=your_discord_ops_channel_webhook_url
DISCORD_ALERTS_ENABLED=False

# === OPTIONAL LOCAL DEV ===
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
